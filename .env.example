# Copy this file to .env and fill in both values from the Supabase dashboard:
# Project Settings > API Keys.
#
# VITE_SUPABASE_ANON_KEY takes the PUBLISHABLE key (sb_publishable_...);
# the legacy "anon public" key also works. It is safe to expose in the
# browser — Row Level Security means it grants no data access without a
# staff login. Never put the secret / service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
